{
	"name": "@ao-barbosa/phi-tui",
	"version": "0.85.0",
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:win32": "bun native/win32/build.mjs",
		"test": "bun test --isolate --preload ../../test-support/setup.ts --timeout 30000 test/",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.c",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ao-Barbosa/phi.git",
		"directory": "packages/tui"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2"
	},
	"contributors": [
		{
			"name": "ao-Barbosa",
			"url": "https://github.com/ao-Barbosa"
		}
	]
}
