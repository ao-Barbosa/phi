{
	"name": "@ao-barbosa/phi-ai",
	"version": "0.85.0",
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/compat.js",
		"./dist/images.js",
		"./dist/providers/images/register-builtins.js"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		},
		"./bedrock-provider": {
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		},
		"./bun-oauth": {
			"types": "./dist/bun-oauth.d.ts",
			"import": "./dist/bun-oauth.js"
		}
	},
	"bin": {
		"phi-ai": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"generate-models": "bun scripts/generate-models.ts --strict",
		"hydrate-model-data": "bun scripts/generate-models.ts --strict --data-only",
		"generate-model-catalog": "bun scripts/generate-models.ts --strict --json-only --json-output ../../.artifacts/model-catalog",
		"generate-image-models": "bun scripts/generate-image-models.ts --strict",
		"check:model-data": "bun scripts/check-model-data.ts",
		"build": "bun run generate-models && bun run build:offline",
		"build:offline": "bun run check:model-data && tsgo -p tsconfig.build.json && rm -rf dist/providers/data && cp -R src/providers/data dist/providers/data",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.123.0",
		"@aws-sdk/client-bedrock-runtime": "3.1048.0",
		"@ao-barbosa/phi-telemetry": "^0.85.0",
		"@google/genai": "1.52.0",
		"@smithy/node-http-handler": "4.7.3",
		"@smithy/types": "4.18.0",
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.6",
		"openai": "6.40.0",
		"partial-json": "0.1.7",
		"typebox": "1.3.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ao-Barbosa/phi.git",
		"directory": "packages/ai"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	},
	"contributors": [
		{
			"name": "ao-Barbosa",
			"url": "https://github.com/ao-Barbosa"
		}
	]
}
