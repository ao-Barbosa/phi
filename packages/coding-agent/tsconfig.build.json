{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@ao-barbosa/phi-chord": ["../chord/dist/index.d.ts"],
			"@ao-barbosa/phi-chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@ao-barbosa/phi-chord/node": ["../chord/dist/node.d.ts"],
			"@ao-barbosa/phi-agent-core": ["../agent/dist/index.d.ts"],
			"@ao-barbosa/phi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@ao-barbosa/phi-ai": ["../ai/dist/index.d.ts"],
			"@ao-barbosa/phi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@ao-barbosa/phi-client": ["../client/dist/index.d.ts"],
			"@ao-barbosa/phi-client/unix": ["../client/dist/unix.d.ts"],
			"@ao-barbosa/phi-client/*": ["../client/dist/*.d.ts"],
			"@ao-barbosa/phi-server": ["../server/dist/index.d.ts"],
			"@ao-barbosa/phi-server/unix": ["../server/dist/transports/unix/index.d.ts"],
			"@ao-barbosa/phi-server/*": ["../server/dist/*.d.ts", "../server/dist/transports/*/index.d.ts"],
			"@ao-barbosa/phi-protocol": ["../protocol/dist/index.d.ts"],
			"@ao-barbosa/phi-tui": ["../tui/dist/index.d.ts"],
			"@ao-barbosa/phi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
