{
	"name": "@ao-barbosa/phi-session-backend-sqlite-node",
	"version": "0.85.0",
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2",
	"description": "Node sqlite session backend for @ao-barbosa/phi-agent-core sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && bun scripts/copy-migrations.mjs",
		"bench:session:timing": "bun benchmark/session/session-repo.bench.ts && bun benchmark/session/storage.bench.ts",
		"test": "bun test --isolate --preload ../../../test-support/setup.ts --timeout 30000",
		"coverage": "bun test --preload ../../../test-support/setup.ts --timeout 30000 --coverage",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ao-Barbosa/phi.git",
		"directory": "packages/session-backends/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@ao-barbosa/phi-ai": "^0.85.0",
		"@ao-barbosa/phi-agent-core": "^0.85.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.9",
		"vitest": "4.1.9"
	},
	"contributors": [
		{
			"name": "ao-Barbosa",
			"url": "https://github.com/ao-Barbosa"
		}
	]
}
