{
	"name": "@ao-barbosa/phi-telemetry",
	"version": "0.85.0",
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2",
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for phi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ao-Barbosa/phi.git",
		"directory": "packages/telemetry"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	},
	"contributors": [
		{
			"name": "ao-Barbosa",
			"url": "https://github.com/ao-Barbosa"
		}
	]
}
