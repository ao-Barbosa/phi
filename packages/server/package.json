{
	"name": "@ao-barbosa/phi-server",
	"version": "0.85.0",
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2",
	"description": "experimental server package for phi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json",
		"test": "bun test --isolate --preload ../../test-support/setup.ts --timeout 30000",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"keywords": [
		"phi",
		"server"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ao-Barbosa/phi.git",
		"directory": "packages/server"
	},
	"dependencies": {
		"@ao-barbosa/phi-chord": "^0.85.0",
		"@ao-barbosa/phi-agent-core": "^0.85.0",
		"@ao-barbosa/phi-protocol": "^0.85.0"
	},
	"devDependencies": {
		"vitest": "4.1.9"
	},
	"contributors": [
		{
			"name": "ao-Barbosa",
			"url": "https://github.com/ao-Barbosa"
		}
	]
}
